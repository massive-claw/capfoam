FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      transportProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

phases          (fluid air);

fluid
{
    transportModel  CrossPowerLaw;
    CrossPowerLawCoeffs
    {
        nu0             25;
        nuInf           0.05;
        m               0.75;
        n               0.15;
    }
    rho             750;
}

air
{
    transportModel  Newtonian;
    nu              1.48e-05;
    rho             1.2;
}

sigma           0.03;


